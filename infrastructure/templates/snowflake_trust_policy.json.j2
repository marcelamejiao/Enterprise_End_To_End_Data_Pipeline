{% if snowflake_iam_user_arn | default('') %}
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "AWS": "{{ snowflake_iam_user_arn }}"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
                "StringEquals": {
                    "sts:ExternalId": "{{ snowflake_external_id | default('') }}"
                }
            }
        }
    ]
}
{% else %}
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Deny",
            "Principal": { "AWS": "*" },
            "Action": "sts:AssumeRole"
        }
    ]
}
{% endif %}
